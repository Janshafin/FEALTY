# ── Chains ──────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=                 # Alchemy/Infura Sepolia HTTPS endpoint
# ── Keys (separate funded Sepolia wallets; NEVER commit real values) ─
DEPLOYER_PK=                     # deploys realm + season, registers the realm name
TYRANT_PK=                       # the scripted Tyrant bot
KEEPER_PK=                       # opens/resolves ballots, writes Chronicle to Arkiv
FAUCET_PK=                       # funds new players with Sepolia ETH + Rabdi tGLM
NPC_MNEMONIC=                    # seeds NPC vassals (demo map)
ATTESTER_PK=                     # Mode B only (WORLD_MODE=attested)
# ── Game config (season) ────────────────────────────────────────────
REALM_LABEL=fealty               # <REALM_LABEL>.eth, change if taken on Sepolia
SEASON=s1
SEASON_DURATION_S=1800
POWER_COOLDOWN_S=45
BALLOT_DURATION_S=120
MIN_YES_VOTES=1
QUORUM_PLEDGES=3
MANIFESTO_TTL_S=180              # must be even (Arkiv 2s blocks)
# ── World ID ────────────────────────────────────────────────────────
WORLD_MODE=onchain               # onchain | attested (decided by spike S2)
WORLD_APP_ID=                    # Developer Portal staging app
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=            # server-side only
WORLD_ACTION=fealty-vote
WORLD_ENV=staging
# ── Arkiv (Rabdi testnet, chain 7794095) ────────────────────────────
ARKIV_ACCESS_KEY=                # from hub.arkiv.network/access-keys
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
# ── Tyrant bot ──────────────────────────────────────────────────────
TYRANT_ENABLED=true
TYRANT_REACTION_MS=8000          # main difficulty knob
TYRANT_PANIC=0.6
TYRANT_IDLE_TAUNT=0.2
# ── Faucet / server ─────────────────────────────────────────────────
FAUCET_SEPOLIA_WEI=3000000000000000
FAUCET_TGLM=0.5
FRONTEND_ORIGIN=http://localhost:5173
KEEPER_INTERVAL_MS=4000
